# Niu-MissionControl Environment Configuration
# Copy this file to .env and fill in values.

# ── Authentication ────────────────────────────────────────
# API key untuk akses endpoints. Wajib diisi untuk production.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MC_API_KEY=

# ── CORS ──────────────────────────────────────────────────
# Comma-separated allowed origins. Default: localhost only.
MC_CORS_ORIGINS=http://localhost:5200

# ── Rate Limiting ─────────────────────────────────────────
# Max requests per minute per IP. Default: 60.
MC_RATE_LIMIT=60

# ── Hermes Gateway ────────────────────────────────────────
# Telegram bot token (dari @BotFather)
TELEGRAM_BOT_TOKEN=

# Path ke Hermes home directory
HERMES_HOME=/Volumes/HermesAgent/HermesAgentUSB/data

# Telegram chat ID untuk notifikasi
HERMES_TELEGRAM_CHAT_ID=
