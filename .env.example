# Niu-MissionControl Environment Configuration
# Copy this file to .env and fill in values.

# ── Authentication ────────────────────────────────────────
# API key untuk akses endpoints. Kosong = auth disabled (dev mode).
#MC_API_KEY=

# ── CORS ──────────────────────────────────────────────────
# Comma-separated allowed origins. Default: localhost only.
#MC_CORS_ORIGINS=http://localhost:5200

# ── Rate Limiting ─────────────────────────────────────────
# Max requests per minute per IP. Default: 60.
#MC_RATE_LIMIT=60

# ── Hermes Gateway ────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
HERMES_HOME=/Volumes/HermesAgent/HermesAgentUSB/data
HERMES_TELEGRAM_CHAT_ID=-1004204696417
