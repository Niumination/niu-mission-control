# systemd unit — Niumination Mission Control v4.1 Aether Sync
# Next.js 16.3.5 + PWA + i18n + DOX v4.0
# Place in /etc/systemd/system/niumination-missioncontrol.service
# Then: systemctl daemon-reload && systemctl enable --now niumination-missioncontrol

[Unit]
Description=Niumination Mission Control v4.1 Aether Sync - Personal AI OS Dashboard (Next.js 16.3.5 + PWA + i18n)
After=network.target
Wants=network-online.target

[Service]
Type=simple
User=niu
Group=niu
WorkingDirectory=/opt/niu-mission-control/apex-ui
ExecStart=/usr/bin/node /opt/niu-mission-control/apex-ui/.next/standalone/server.js
# Fallback: server.js in standalone root
# ExecStart=/usr/bin/node /opt/niu-mission-control/apex-ui/server.js

Restart=always
RestartSec=10
StartLimitInterval=60
StartLimitBurst=3

# Environment
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=0.0.0.0
Environment=MC_DB_PATH=/opt/niu-mission-control/data/swarm_state.db
Environment=LOG_LEVEL=info
Environment=BUDGET_ENFORCEMENT=soft
EnvironmentFile=-/opt/niu-mission-control/.env.local
EnvironmentFile=-/opt/niu-mission-control/apex-ui/.env.local

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=niu-mission-control

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/opt/niu-mission-control/data /opt/niu-mission-control/logs /opt/niu-mission-control/data/backups
LimitNOFILE=10240
MemoryMax=1G

[Install]
WantedBy=multi-user.target
