# =============================================================================
# Niumination Mission Control v4.0 Aether — Environment Variables
# Copy file ini ke .env.local di apex-ui/ (atau repo root) untuk dev.
# Untuk Docker: env_file di docker-compose.yml mengarah ke ../.env.local
# =============================================================================

# ── Auth (wajib, fail-fast jika kosong saat production) ──────────────────
# MC_PASSWORD_HASH: scrypt hash dari password.
# Generate: node apex-ui/scripts/hash-password.mjs "passwordmu"
MC_PASSWORD_HASH=

# MC_API_KEY: API key untuk akses programmatic (CLI, webhook, MCP, X-API-Key header)
# Generate: node apex-ui/scripts/generate-api-key.mjs
MC_API_KEY=

# MC_SESSION_SECRET: 32 byte random hex (min 32 chars)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MC_SESSION_SECRET=

# ── Database ──────────────────────────────────────────────────────────────
# Custom path ke SQLite DB (default: ../data/swarm_state.db dari apex-ui/)
# Di Docker: /app/data/swarm_state.db (via volume)
# MC_DB_PATH=/opt/niu-mission-control/data/swarm_state.db
MC_DB_PATH=

# ── Hermes CLI (Adapter) ─────────────────────────────────────────────────
# Path ke binary hermes (untuk hermes adapter)
# which hermes → /usr/local/bin/hermes atau /opt/homebrew/bin/hermes
HERMES_PATH=/usr/local/bin/hermes
HERMES_CLI=/usr/local/bin/hermes

# Chat ID Telegram untuk notifikasi (optional)
# Bisa group ID negatif seperti -1001234567890
HERMES_TELEGRAM_CHAT_ID=
TELEGRAM_CHAT_ID=

# ── Network ───────────────────────────────────────────────────────────────
# Bind address (default 127.0.0.1 dev, 0.0.0.0 prod via HOSTNAME)
# MC_BIND=127.0.0.1
HOSTNAME=0.0.0.0
PORT=3000

# ── Logging ───────────────────────────────────────────────────────────────
# Level: debug|info|warn|error (default: debug dev, info prod)
LOG_LEVEL=info

# ── Budget (optional, untuk alert) ───────────────────────────────────────
# Daily/monthly budget USD untuk alert (hard kill-switch future)
DAILY_BUDGET_USD=10
MONTHLY_BUDGET_USD=100

# ── Notifications ─────────────────────────────────────────────────────────
# Telegram chat ID untuk alert (approval needed, error streak, daily cost)
# TELEGRAM_CHAT_ID sudah di atas, bisa juga:
# MC_TELEGRAM_CHAT_ID=

# ── App Settings (via DB app_settings, tapi bisa override env) ───────────
# INSTANCE_NAME=Niumination Mission Control
# TIMEZONE=Asia/Jakarta
# THEME=dark

# ── Development ───────────────────────────────────────────────────────────
NODE_ENV=production
# MC_ALLOW_RESET=1 # hanya dev, izinkan reset password via /api/auth/setup
